# Copy this file to .env and fill in your keys. The .env is loaded once when
# the server starts; nothing here is written back to disk. Real shell env vars
# override anything set here.

# Required for the chat, describe, and repair loops
ANTHROPIC_API_KEY=

# Optional: only needed if you generate servers that call these services
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
OPENAI_API_KEY=

# Generic bearer for OpenAPI-derived servers (Stripe test key, etc.)
API_TOKEN=

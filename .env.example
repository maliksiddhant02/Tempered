# Copy this file to .env and fill in your keys. The .env is loaded once when
# the server starts; nothing here is written back to disk. Real shell env vars
# override anything set here.

# Required for the chat, describe, and repair loops
ANTHROPIC_API_KEY=

# Optional: only needed if you generate servers that call these services
SLACK_WEBHOOK_URL=
OPENAI_API_KEY=

# Preset connectors. Open-Meteo, CoinGecko, NASA (DEMO_KEY) and Pollinations
# need NOTHING here — they run out of the box. These raise limits / unlock more:
NASA_API_KEY=            # optional; without it NASA falls back to DEMO_KEY
UNSPLASH_ACCESS_KEY=     # the Unsplash "Access Key" (never the Secret Key)
GITHUB_TOKEN=            # GitHub reads work without it; needed to open issues
DISCORD_WEBHOOK_URL=     # needed for the Discord "post message" preset

# Generic bearer for OpenAPI-derived servers (Stripe test key, etc.)
API_TOKEN=
